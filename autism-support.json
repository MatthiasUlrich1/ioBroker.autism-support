      "name": "autism-support",
      "version": "0.2.12",
      "title": "Autism Support",
      "titleLang": {
        "en": "Autism Support",
        "de": "Autismus-Unterstützung",
        "es": "Apoyo para el autismo",
        "fr": "Soutien pour l'autisme",
        "it": "Supporto per l'autismo",
