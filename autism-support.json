      },
      "desc": {
        "en": "Support for people with autism: Visual Countdown, pictogram-based schedules and pictogram library",
        "de": "Unterstützung für Menschen mit Autismus: Visueller Countdown, bildbasierte Ablaufpläne und Piktogramm-Bibliothek",
        "es": "Apoyo para personas con autismo: Cuenta regresiva visual, horarios basados en pictogramas y biblioteca de pictogramas",
        "fr": "Soutien aux personnes autistes : Compte à rebours visuel, emplois du temps par pictogrammes et bibliothèque de pictogrammes",
        "it": "Supporto per persone con autismo: Countdown visivo, programmi basati su pittogrammi e libreria di pittogrammi",
        "nl": "Ondersteuning voor mensen met autisme: Visuele aftelling, pictogrambaseerde schema's en pictogrambibliotheek",
        "pl": "Wsparcie dla osób z autyzmem: Wizualne odliczanie, plany oparte na piktogramach i biblioteka piktogramów",
        "pt": "Apoio para pessoas com autismo: Contagem regressiva visual, agendas baseadas em pictogramas e biblioteca de pictogramas",
        "ru": "Поддержка людей с аутизмом: Визуальный обратный отсчёт, расписания на основе пиктограмм и библиотека пиктограмм",
        "uk": "Підтримка людей з аутизмом: Візуальний зворотний відлік, розклади на основі піктограм та бібліотека піктограм",
        "zh-cn": "支持自闭症人士：可视化倒计时、基于象形图的日程和象形图库"
      },
      "icon": "autism-support.png",
      "extIcon": "https://raw.githubusercontent.com/MatthiasUlrich1/ioBroker.autism-support/master/admin/autism-support.png",
      "keywords": [
        "autism",
        "timer",
        "visual-countdown",
        "schedule",
        "pictogram",
        "vis-2",
        "accessibility"
      ],
      "license": "MIT",
      "platform": "JavaScript/Node.js",
      "mode": "daemon",
      "type": "general",
      "connectionType": "local",
      "dataSource": "push",
      "adminUI": {
        "config": "json"
      },
      "compact": true,
      "onlyWWW": false,
      "singleton": false,
      "readme": "https://github.com/MatthiasUlrich1/ioBroker.autism-support/blob/master/README.md",
      "loglevel": "info",
      "news": {
        "0.2.12": {
          "en": "Fixed: Widget i18n translations for 9 languages, English folder/file names in vis-2 store, ARASAAC fetch timeout",
          "de": "Behoben: Widget-i18n-Übersetzungen für 9 Sprachen, englische Ordner-/Dateinamen im vis-2-Speicher, ARASAAC-Fetch-Timeout"
        },
        "0.2.11": {
          "en": "Fixed: Admin i18n translations, removed custom config, fixed extendForeignObjectAsync on own config",
          "de": "Behoben: Admin-i18n-Übersetzungen, benutzerdefinierte Konfiguration entfernt, extendForeignObjectAsync für eigene Konfiguration repariert"
