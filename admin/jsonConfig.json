					"text": "arasaac_license_info",
					"style": { "fontSize": "0.9em" },
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12
				},
				"_customInfo": {
					"type": "staticText",
					"text": "custom_pictogram_info",
					"style": { "fontSize": "0.9em", "opacity": 0.9 },
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12
				},
				"_customHint": {
					"type": "staticText",
					"text": "custom_pictograms_hint",
					"style": { "fontSize": "0.9em", "opacity": 0.85 },
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12
				},
				"_pictogramUpload": {
					"type": "fileSelector",
					"label": "custom_pictogram_upload",
					"objectID": "autism-support.%INSTANCE%",
					"upload": "pictograms",
					"pattern": "pictograms/*.*",
					"fileTypes": "image",
					"delete": true,
					"refresh": true,
					"withFolder": true,
					"maxSize": 5242880,
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12
				},
				"customPictograms": {
					"type": "table",
					"label": "custom_pictograms_table",
					"noDelete": false,
					"showFirstAddOnTop": true,
					"clone": false,
					"import": false,
					"export": false,
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12,
					"items": [
						{
							"type": "text",
							"attr": "file",
							"title": "custom_pictogram_file",
							"width": "45%",
							"default": "",
							"defaultFunc": "return data._pictogramUpload || '';"
						},
						{
							"type": "text",
							"attr": "label",
							"title": "custom_pictogram_label",
							"width": "25%",
							"default": ""
						},
						{
							"type": "text",
							"attr": "tags",
							"title": "custom_pictogram_tags",
							"width": "30%",
							"default": ""
						}
					]
				}
			}
