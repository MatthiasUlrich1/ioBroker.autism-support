					"lg": 3,
					"xl": 3
				},
				"_timerHint": {
					"type": "staticText",
					"text": "timer_settings_hint",
					"style": {
						"fontSize": "0.9em",
						"opacity": 0.85
					},
					"newLine": true,
					"xs": 12,
					"sm": 12,
